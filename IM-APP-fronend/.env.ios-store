# 本分支专用：App Store 上架。Mac 打包直接用，一般不必再写 .env.ios-store.local。
# 仅当要覆盖下方某一项时，才在本机建 .env.ios-store.local（勿提交）。
VITE_DISTRIBUTION=app-store
VITE_API_BASE_URL=https://www.xn--jprz53bj9s.com/api/v1
VITE_IM_API_URL=https://www.xn--jprz53bj9s.com/openim-api
VITE_IM_WS_URL=wss://www.xn--jprz53bj9s.com/openim-ws
VITE_PRIVACY_POLICY_URL=https://www.xn--jprz53bj9s.com/static/legal/privacy.html
VITE_USER_AGREEMENT_URL=https://www.xn--jprz53bj9s.com/static/legal/agreement.html
# App Store Connect → App 信息 → Apple ID（纯数字）。填好前 build:ios-store 会失败。
VITE_APP_STORE_ID=
