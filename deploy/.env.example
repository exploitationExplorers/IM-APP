# ───────────────────────────────────────────────────────────────────────────
# IM-APP 业务栈变量模板（全新部署 · 8.154.44.197 · 纯 IP / HTTP）
#
# 用法：cp deploy/.env.example deploy/.env，然后填掉所有 <...> 占位。
# 真 deploy/.env 不入库（在 .gitignore 里）。
#
# 三组「必须同值」的密钥，配错都是静默故障，最难查：
#   1. IM_INTERNAL_API_KEY   == SERVER_INTERNAL_KEY
#      → 不一致：管理后台改数据全部失败
#   2. OPENIM_SECRET          == OpenIM 栈 IMENV_SHARE_SECRET
#      → 不一致：后端调 OpenIM 全部 401
#   3. OPENIM_WEBHOOK_SECRET  == OpenIM 栈 IMENV_CALLBACK_URL 的路径段
#      → 不一致：webhook 全部 401，消息审核/撤回静默失效
#   后两组靠 --env-file ../.env 从本文件同源读取，两边不要各写一份。
# ───────────────────────────────────────────────────────────────────────────

# ===== 对外地址（纯 IP，无域名 = 永久 HTTP）=====
OPENIM_PUBLIC_API_URL=http://8.154.44.197/openim-api
OPENIM_PUBLIC_WS_URL=ws://8.154.44.197/openim-ws
MINIO_PUBLIC_URL=http://8.154.44.197/minio
MINIO_EXTERNAL_ADDRESS=http://8.154.44.197/openim
CORS_ALLOW_ORIGINS=http://8.154.44.197

# ===== OpenIM 对接 =====
OPENIM_API_URL=http://openim-api:10002
OPENIM_SECRET=<与 OpenIM 栈 IMENV_SHARE_SECRET 同值>
OPENIM_ADMIN_USER=imAdmin
OPENIM_WEBHOOK_SECRET=<随机长串，与 IMENV_CALLBACK_URL 路径段同值>
# 必须等于 im-app-openim-net 的 Subnet（建网命令里指定的是 172.20.0.0/16）
OPENIM_WEBHOOK_ALLOW_CIDRS=127.0.0.1/32,172.20.0.0/16
OPENIM_RECALL_WINDOW_SECONDS=120

IM_INTERNAL_API_KEY=<随机长串，与 SERVER_INTERNAL_KEY 同值>

GROUP_MEMBER_HARD_LIMIT=4000

# ===== 认证与运行模式 =====
JWT_SECRET=<随机长串>
DEV_SMS_CODE=
LEGACY_CHAT_ENABLED=false
SEED_DEMO=false

# ===== 对象存储 =====
MINIO_PUBLIC_READ=true

# ===== 万人转发 Kafka =====
KAFKA_BROKERS=kafka:19092
KAFKA_FORWARD_TOPIC=im-forward-tasks
KAFKA_FORWARD_GROUP_ID=im-forward-workers
FORWARD_WORKER_ENABLED=true
FORWARD_BATCH_SIZE=50
FORWARD_MAX_ATTEMPTS=8
FORWARD_CONCURRENCY=4
FORWARD_QPS=20
FORWARD_POLL_SECONDS=2
FORWARD_LOCK_SECONDS=300

# ===== 阿里云短信 =====
# 若 AccessKey 在 RAM 里配过 IP 白名单，需把 8.154.44.197 加进去
ALIYUN_ACCESS_KEY_ID=<沿用原值>
ALIYUN_ACCESS_KEY_SECRET=<沿用原值>
SMS_SIGN_NAME=<沿用原值>
SMS_TEMPLATE_CODE=<沿用原值>
SMS_REGION_ID=cn-hangzhou
CAPTCHA_REGION_ID=cn-hangzhou

# ===== 验证码发送节流（手机号 / 设备指纹 / DeviceID / IP 农场）=====
# 只做频率节流，不设次数配额：原来「每 IP 5 次/小时」「每手机号 10 次/天」已去掉，
# 免得共用出口 IP 的正常用户被误伤。主力是「同一手机号 60 秒一条」。
# 任一项配 0 即关闭该维度。值后面不要写行内注释，解析器不剥离，写了整行失效。
SMS_PHONE_MIN_INTERVAL=60
SMS_FP_LIMIT=30
SMS_FP_WINDOW=3600
SMS_DEVICE_LIMIT=20
SMS_DEVICE_WINDOW=3600
SMS_IP_MAX_FPS=0
SMS_IP_FARM_BLOCK_SEC=600
SMS_BLACKLIST_ENABLED=true

# ===== 管理后台 IM-APP-admin =====
# ★ release 模式下短于 32 字符会拒绝启动（config.WeakJWTSecret）
ADMIN_JWT_SECRET=<至少 32 字符的随机串>
ADMIN_BOOTSTRAP_USERNAME=admin
# ★★ 首次启动必改！空库第一启动用它创建超管；admin_users 非空后改这里不再生效
ADMIN_BOOTSTRAP_PASSWORD=<首启超管密码>
ADMIN_CORS_ORIGINS=http://8.154.44.197:8081
GIN_MODE=release
SERVER_BASE_URL=http://api:8080
SERVER_INTERNAL_KEY=<与 IM_INTERNAL_API_KEY 同值>
