# OpenIM 回调（webhook）配置 —— 模板，拷成同目录的 webhooks.yml 再改
#
#   cp webhooks.yml.example webhooks.yml
#   S=$(grep '^OPENIM_WEBHOOK_SECRET=' ../.env | cut -d= -f2)
#   sed -i "s|REPLACE_WITH_OPENIM_WEBHOOK_SECRET|$S|" webhooks.yml
#
# ★★ 为什么必须配这个文件：
#   业务后端的「撤回」「消息审核」「消息发送记录」都读同一张表 im_message_audit，
#   而这张表只由 OpenIM 的 afterSend 回调写入。不配 = 表永远是空的 =
#   **每一次撤回都返回 404「消息不存在或消息标识不匹配」**（handler/im.go），
#   同时在管理后台看不到任何消息记录。表现为「消息明明发出去了，就是撤不了」。
#
# ★ 官方镜像不认 IMENV_CALLBACK_URL 环境变量，只能靠这个文件。
#   compose 里已把它挂到容器的 /openim-server/config/webhooks.yml。
#
# ★ 这个文件含密钥，真正的 webhooks.yml 已加进 .gitignore，不要提交。
#
# url 里的路径段必须与 deploy/.env 的 OPENIM_WEBHOOK_SECRET 完全一致，
# 否则后端 authorize 失败 → 回调全 401 → 又是同样的症状。
# 服务名 api 走共享网络 im-app-openim-net（后端也在那张网上）。
url: http://api:8080/internal/openim/webhooks/REPLACE_WITH_OPENIM_WEBHOOK_SECRET

# ───────────────────────────────────────────────────────────────────────────
# ★ 下面五个是业务后端实际用到的，必须 enable: true
#   afterSendSingleMsg / afterSendGroupMsg —— 写 im_message_audit（撤回/审核/发送记录全靠它）
#   afterRevokeMsg                        —— 撤回状态同步
#   beforeSendSingleMsg / beforeSendGroupMsg —— 发送前校验（非好友/拉黑/禁言拦截）
#   beforeXxx 里的 failedContinue: false 是有意的：校验不通过时直接拦下消息，
#   不要让 OpenIM 以为回调失败而放行。
# ───────────────────────────────────────────────────────────────────────────
beforeSendSingleMsg:
  enable: true
  timeout: 5
  failedContinue: false
  # Only the contentType in allowedTypes will send the callback.
  # Supports two formats: a single type or a range. The range is defined by the lower and upper bounds connected with a hyphen ("-").
  # e.g. allowedTypes: [1, 100, 200-500, 600-700] means that only contentType within the range
  # {1, 100} ∪ [200, 500] ∪ [600, 700] will be allowed through the filter.
  # If not set, all contentType messages will through this filter.
  allowedTypes: []
  # Only the contentType not in deniedTypes will send the callback.
  # Supports two formats, same as allowedTypes.
  # If not set, all contentType messages will through this filter.
  deniedTypes: []
beforeUpdateUserInfoEx:
  enable: false
  timeout: 5
  failedContinue: true
afterUpdateUserInfoEx:
  enable: false
  timeout: 5
afterSendSingleMsg:
  enable: true
  timeout: 5
  # Only the senID/recvID specified in attentionIds will send the callback
  # if not set, all user messages will be callback
  attentionIds: []
  # See beforeSendSingleMsg comment.
  allowedTypes: []
  deniedTypes: []
beforeSendGroupMsg:
  enable: true
  timeout: 5
  failedContinue: false
  # See beforeSendSingleMsg comment.
  allowedTypes: []
  deniedTypes: []
beforeMsgModify:
  enable: false
  timeout: 5
  failedContinue: true
  # See beforeSendSingleMsg comment.
  allowedTypes: []
  deniedTypes: []
afterSendGroupMsg:
  enable: true
  timeout: 5
  # See beforeSendSingleMsg comment.
  allowedTypes: []
  deniedTypes: []
afterUserOnline:
  enable: false
  timeout: 5
afterUserOffline:
  enable: false
  timeout: 5
afterUserKickOff:
  enable: false
  timeout: 5
beforeOfflinePush:
  enable: false
  timeout: 5
  failedContinue: true
