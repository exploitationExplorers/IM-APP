# This file contains placeholders, never production credentials.
# Run: node deploy/oss-test/init-env.cjs
# The initializer creates independent infrastructure/app secrets; OSS credentials are not generated.
COMPOSE_PROJECT_NAME=im-app-oss-test
TEST_PG_ADMIN_PASSWORD=replace_with_test_only_secret
TEST_PG_APP_PASSWORD=replace_with_test_only_secret
TEST_REDIS_PASSWORD=replace_with_test_only_secret
TEST_OPENIM_REDIS_PASSWORD=replace_with_test_only_secret
TEST_MONGO_ROOT_PASSWORD=replace_with_test_only_secret
TEST_MONGO_APP_PASSWORD=replace_with_test_only_secret
TEST_MINIO_ACCESS_KEY=replace_with_test_only_access_key
TEST_MINIO_SECRET_KEY=replace_with_test_only_secret
TEST_OPENIM_MINIO_ACCESS_KEY=replace_with_test_only_access_key
TEST_OPENIM_MINIO_SECRET_KEY=replace_with_test_only_secret

# Used by the isolated application stack; never copy from a production .env.
TEST_JWT_SECRET=replace_with_test_only_secret
TEST_ADMIN_JWT_SECRET=replace_with_test_only_secret
TEST_INTERNAL_API_KEY=replace_with_test_only_secret
TEST_OPENIM_SECRET=replace_with_test_only_secret
TEST_WEBHOOK_SECRET=replace_with_test_only_secret
TEST_ADMIN_BOOTSTRAP_PASSWORD=replace_with_test_only_secret
TEST_PUBLIC_ORIGIN=https://localhost:18443
TEST_ADMIN_ORIGIN=https://localhost:18444
TEST_OSS_REGION=cn-hongkong
TEST_OSS_CHAT_BUCKET=yikeliao-188-hk-test
TEST_OSS_BUSINESS_BUCKET=yikeliao-188-business-hk-test
TEST_OSS_CHAT_ORIGIN=https://oss-chat-test.xn--jprz53bj9s.com
TEST_OSS_BUSINESS_ORIGIN=https://oss-business-test.xn--jprz53bj9s.com
# Mapped by prepare-apps.cjs; no native unpatched OpenIM prefix setting exists.
TEST_OSS_CHAT_PREFIX=oss-test/chat/
TEST_OSS_BUSINESS_PREFIX=oss-test/business/
TEST_OSS_DELETE_ENABLED=false
# Reuse the existing im-app-oss RAM credentials; fill locally, never commit or paste into chat.
TEST_OSS_ACCESS_KEY_ID=
TEST_OSS_ACCESS_KEY_SECRET=
