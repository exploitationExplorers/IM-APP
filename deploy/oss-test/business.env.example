# TEST ONLY. Inject as process/container environment, not into the existing server .env.
# Explicit APP_ENV=oss-test prevents config.Load from reading conventional .env.
APP_ENV=oss-test
STORAGE_PROVIDER=oss
HTTP_ADDR=127.0.0.1:18080
DATABASE_URL=postgres://im_oss_test:REPLACE_TEST_PG_APP_PASSWORD@127.0.0.1:15433/imapp_oss_test?sslmode=disable
REDIS_URL=redis://:REPLACE_TEST_REDIS_PASSWORD@127.0.0.1:16379/0
JWT_SECRET=REPLACE_TEST_JWT_SECRET
IM_INTERNAL_API_KEY=REPLACE_TEST_INTERNAL_API_KEY
LEGACY_CHAT_ENABLED=false
SEED_DEMO=false
FORWARD_WORKER_ENABLED=false
KAFKA_BROKERS=
KAFKA_FORWARD_TOPIC=im-forward-tasks_oss_test
KAFKA_FORWARD_GROUP_ID=im-forward-workers_oss_test
# Disabled until the independent test OpenIM application stack is ready.
OPENIM_API_URL=
OPENIM_PUBLIC_API_URL=
OPENIM_PUBLIC_WS_URL=
OPENIM_SECRET=
OPENIM_WEBHOOK_SECRET=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=im-uploads-oss-test
MINIO_PUBLIC_URL=
MINIO_PUBLIC_READ=false
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
CORS_ALLOW_ORIGINS=https://oss-test.example.invalid
OSS_REGION=cn-hongkong
OSS_ENDPOINT=https://oss-cn-hongkong.aliyuncs.com
OSS_BUCKET=yikeliao-188-business-hk-test
OSS_PUBLIC_UPLOAD_URL=https://oss-business-test.xn--jprz53bj9s.com
OSS_KEY_PREFIX=oss-test/business/
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
