{
  "info": {
    "name": "Private retention visibility v2 (NO PUBLIC EXPOSURE)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Private ports only. Logical bridge objectPurge=off does not describe separate managed GC at 19094. Do not enable raw configure directly: cleanup-production.py verifies all live writer hashes first. No legacy sweep or Mongo body purge."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{retention_adapter_key}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base",
      "value": "http://openim-api:19093"
    },
    {
      "key": "retention_adapter_key",
      "value": ""
    },
    {
      "key": "groupId",
      "value": "11111111111141118111111111111111"
    },
    {
      "key": "snapshotId",
      "value": ""
    },
    {
      "key": "minVisibleSeq",
      "value": ""
    },
    {
      "key": "gc_base",
      "value": "http://openim-api:19094"
    }
  ],
  "item": [
    {
      "name": "Capabilities",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base}}/internal/retention/capabilities",
          "host": [
            "{{base}}"
          ],
          "path": [
            "internal",
            "retention",
            "capabilities"
          ]
        }
      }
    },
    {
      "name": "Classified snapshot (private group)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base}}/internal/retention/snapshot?groupId={{groupId}}",
          "host": [
            "{{base}}"
          ],
          "path": [
            "internal",
            "retention",
            "snapshot"
          ],
          "query": [
            {
              "key": "groupId",
              "value": "{{groupId}}"
            }
          ]
        }
      }
    },
    {
      "name": "Apply exact receipt boundary (changes visibility)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/internal/retention/apply",
          "host": [
            "{{base}}"
          ],
          "path": [
            "internal",
            "retention",
            "apply"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"snapshotId\":\"{{snapshotId}}\",\"conversationId\":\"sg_{{groupId}}\",\"minVisibleSeq\":{{minVisibleSeq}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Protect media reference",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base}}/internal/media-gc/protect",
          "host": [
            "{{base}}"
          ],
          "path": [
            "internal",
            "media-gc",
            "protect"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"content\": \"\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "GC status",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{gc_base}}/internal/media-gc/status",
          "host": [
            "{{gc_base}}"
          ],
          "path": [
            "internal",
            "media-gc",
            "status"
          ]
        }
      }
    },
    {
      "name": "Configure GC (use release CLI safety gates)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{gc_base}}/internal/media-gc/configure",
          "host": [
            "{{gc_base}}"
          ],
          "path": [
            "internal",
            "media-gc",
            "configure"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"active\": false}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "GC bounded preview",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{gc_base}}/internal/media-gc/run",
          "host": [
            "{{gc_base}}"
          ],
          "path": [
            "internal",
            "media-gc",
            "run"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"dryRun\": true}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}
