package mgo

import (
	"context"
	gc "github.com/openimsdk/open-im-server/v3/internal/imappgc"
	"github.com/openimsdk/open-im-server/v3/pkg/common/storage/model"
	"go.mongodb.org/mongo-driver/bson"
	"go.mongodb.org/mongo-driver/mongo"
	"go.mongodb.org/mongo-driver/mongo/options"
	"os"
	"strings"
	"testing"
	"time"
)

func TestIMAppRetentionGCMappingAndProfileIntegration(t *testing.T) {
	uri := os.Getenv("IM_APP_RETENTION_TEST_MONGO")
	if uri == "" || os.Getenv("IM_APP_RETENTION_TEST_ALLOW_INIT") != "1" {
		t.Skip("disposable Mongo required")
	}
	if !strings.HasPrefix(uri, "mongodb://127.0.0.1:") {
		t.Fatal("loopback only")
	}
	t.Setenv("IM_APP_MEDIA_GC_REFERENCES", "true")
	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
	defer cancel()
	client, err := mongo.Connect(ctx, options.Client().ApplyURI(uri))
	if err != nil {
		t.Fatal(err)
	}
	db := client.Database("imapp_gc_mapping_profile")
	t.Cleanup(func() { _ = db.Drop(context.Background()); _ = client.Disconnect(context.Background()) })
	_, _ = db.Collection(gc.ControlCollection).InsertOne(ctx, bson.M{"_id": gc.Protocol, "active": true})
	key := gc.Namespace + "openim/data/hash/" + strings.Repeat("f", 32)
	other := gc.Namespace + "openim/data/hash/" + strings.Repeat("a", 32)
	if gc.BeginWrite(ctx, db, key) != nil || gc.BeginWrite(ctx, db, other) != nil {
		t.Fatal("seed write failed")
	}
	objects, err := NewS3Mongo(db)
	if err != nil {
		t.Fatal(err)
	}
	obj := &model.Object{Name: "u/file.jpg", Engine: "ali-oss", Key: key, Size: 1}
	if objects.SetObject(ctx, obj) != nil || objects.SetObject(ctx, obj) != nil {
		t.Fatal("idempotent mapping broken")
	}
	obj.Key = other
	if objects.SetObject(ctx, obj) == nil {
		t.Fatal("managed alias replaced: references could point at untracked generations")
	}
	obj.Key = "openim/direct/legacy"
	if objects.SetObject(ctx, obj) == nil {
		t.Fatal("managed alias replaced by untracked legacy key")
	}
	users, err := NewUserMongo(db)
	if err != nil {
		t.Fatal(err)
	}
	if err := users.Create(ctx, []*model.User{{UserID: "u", FaceURL: "https://chat.invalid/" + gc.PhysicalPrefix + key}}); err != nil {
		t.Fatal(err)
	}
	var record gc.Record
	if db.Collection(gc.Collection).FindOne(ctx, bson.M{"_id": key}).Decode(&record) != nil || !record.Permanent {
		t.Fatal("direct native profile did not pin avatar")
	}
	if err := users.AddUserCommand(ctx, "u", 1, "favorite", `{"VideoElem":{"VideoUrl":"https://chat.invalid/`+gc.PhysicalPrefix+other+`"}}`, ""); err != nil {
		t.Fatal(err)
	}
	if db.Collection(gc.Collection).FindOne(ctx, bson.M{"_id": other}).Decode(&record) != nil || !record.Permanent {
		t.Fatal("native user command did not pin favorite")
	}
}
