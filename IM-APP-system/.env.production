# 线上环境
VITE_USER_NODE_ENV = production

# 公共基础路径
# 当前部署方式：管理后台前端产物放在后端服务器 8.154.44.197:8081 的站点根，
# 所以是 /。vite.config.ts 会把这个值读成 base 并传给 createWebHistory。
# ★ 将来若改成「前端服务器 + 域名」，要挂到 /admin/ 子路径下，这里改成 /admin/、
#   下面的 VITE_API_URL 改成 /adminapi。详见 部署操作手册-前后端分离与域名反代.md
VITE_PUBLIC_PATH = /

# 路由模式
# Optional: hash | history
VITE_ROUTER_MODE = history

# 打包时是否删除 console
VITE_DROP_CONSOLE = true

# 线上环境接口地址
# 相对路径 → 与 :8081 这个站点同源，由同一份 nginx 的 /api/ 反代到 127.0.0.1:8090。
# ★ 别写成绝对地址 http://8.154.44.197:8081/api，那会让浏览器发跨域请求，
#   而 ADMIN_CORS_ORIGINS 白名单只对列出的来源回显，容易莫名其妙连不上。
VITE_API_URL = /api
