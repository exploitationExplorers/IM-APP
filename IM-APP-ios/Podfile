source 'https://cdn.cocoapods.org/'
platform :ios, '15.0'
project 'IMNative.xcodeproj'
workspace 'IMNative'

target 'IMNative' do
  use_frameworks! :linkage => :static
  pod 'OpenIMSDK', '3.8.3-hotfix.15'
  # 内存修复版 core（yike memfix，ee4469a）：:podspec 覆盖下载源指向自维护产物。
  # 回滚：删掉 :podspec => 参数即回到官方 3.8.3-hotfix.15 产物。
  # 外部 podspec 不再重复传版本参数；版本由 podspec 和包装层依赖固定。
  pod 'OpenIMSDKCore', :podspec => 'podspecs/OpenIMSDKCore.podspec'
end

# Match the app deployment floor; recent Xcode rejects older Pod targets.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |configuration|
      deployment_target = configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if deployment_target.nil? || Gem::Version.new(deployment_target) < Gem::Version.new('15.0')
        configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end
  end
end

# Make the SDK build order explicit; GUI builds can otherwise skip Pods.
# Resolve the generated target after every install instead of pinning its UUID.
post_integrate do |installer|
  installer.aggregate_targets.each do |aggregate|
    next unless aggregate.name == 'Pods-IMNative'
    project = aggregate.user_project
    pods_target = installer.pods_project.targets.find { |target| target.name == aggregate.name }
    raise 'Missing Pods-IMNative target' unless pods_target
    unless project.reference_for_path(installer.pods_project.path)
      project.main_group.new_reference(installer.pods_project.path.to_s)
    end
    aggregate.user_targets.each { |target| target.add_dependency(pods_target) }
    project.save
  end
end
