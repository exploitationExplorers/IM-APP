# IM-APP 后端 + OpenIM 对接环境变量示例
# 复制为同目录 .env 后按需修改：cp .env.example .env
#
# 前置（只需一次）：docker network create im-app-openim-net
# 说明见 deploy/openim/docker-compose.yml 顶部注释。

# ─────────────────────────────────────────────────────────────
# 1. OpenIM 对接（与 deploy/openim/docker-compose.yml 同源）
# ─────────────────────────────────────────────────────────────

# 共享密钥：OpenIM 的 IMENV_SHARE_SECRET 也读这个变量。
# 两者必须完全一致，否则后端调 OpenIM 接口会 401。默认与官方 openim-docker 一致。
OPENIM_SECRET=openIM123

# 后端内部访问 OpenIM API 的地址（同共享网络用服务名即可）。
# 跨机部署时改成宿主机可访问地址，例如 http://8.210.72.157:10002
OPENIM_API_URL=http://openim-api:10002

# 给客户端（前端 SDK）用的外部可访问地址，远程访问时把 127.0.0.1 换成公网 IP。
# 这两个为空时，后端 /im/token 会直接返回“OpenIM 服务不可用”，前端进不去聊天。
OPENIM_PUBLIC_API_URL=http://127.0.0.1:10002
OPENIM_PUBLIC_WS_URL=ws://127.0.0.1:10001

# OpenIM 管理员账号（用于后端代发消息、注册用户等），一般保持 imAdmin。
OPENIM_ADMIN_USER=imAdmin

# ─────────────────────────────────────────────────────────────
# 2. Webhook（OpenIM 回调后端做加好友校验 / 消息审计）
# ─────────────────────────────────────────────────────────────

# webhook 校验密钥：会同时出现在后端路由路径和 OpenIM 的 callback url 中。
# 建议改成随机串，且必须与 deploy/openim 的 IMENV_CALLBACK_URL 引用的同源变量一致。
OPENIM_WEBHOOK_SECRET=change-me-webhook-secret

# 允许回调的来源网段：填 OpenIM 容器在 im-app-openim-net 网络中的来源 IP 段。
# 先 docker network inspect im-app-openim-net 看 Subnet，例如 172.20.0.0/16。
# 留空则 webhook 不生效（后端 authorized() 直接返回 false）。
OPENIM_WEBHOOK_ALLOW_CIDRS=172.20.0.0/16

# ─────────────────────────────────────────────────────────────
# 3. 内部服务间调用密钥（Go 后端 /internal/im/* 路由用）
# ─────────────────────────────────────────────────────────────
IM_INTERNAL_API_KEY=change-me-internal-api-key

# ─────────────────────────────────────────────────────────────
# 4. 其他（非 OpenIM，保持原样即可）
# ─────────────────────────────────────────────────────────────
JWT_SECRET=im-local-dev-secret-change-me
# 开发万能码：123456 固定（开发阶段用）；正式环境请留空=随机验证码
DEV_SMS_CODE=123456

# Phase 3: Redis + MinIO（docker-compose up 后启用）
REDIS_URL=redis://127.0.0.1:6379/0
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=im-uploads
MINIO_USE_SSL=false
# MinIO 对外访问地址：预签名上传/文件 URL 用它对外的 host（如 http://8.210.72.157:9000）
# 留空则用 MINIO_ENDPOINT（docker 内网地址，外部不可访问）
MINIO_PUBLIC_URL=http://8.210.72.157:9000
# true 时启动自动把桶设为公开读（外网可直接访问文件 URL）
MINIO_PUBLIC_READ=false

# Phase 4: OpenIM（deploy/openim 启动后填写）
OPENIM_API_URL=http://8.210.72.157:10002
OPENIM_PUBLIC_API_URL=http://8.210.72.157:10002
OPENIM_PUBLIC_WS_URL=ws://8.210.72.157:10001
OPENIM_SECRET=
OPENIM_ADMIN_USER=imAdmin
OPENIM_WEBHOOK_SECRET=
# 服务器部署时填写 OpenIM 容器/宿主机出口 IP 或 CIDR，逗号分隔。
OPENIM_WEBHOOK_ALLOW_CIDRS=
# 仅供内网服务调用 /internal/im/*，必须使用独立随机值。
IM_INTERNAL_API_KEY=
# OpenIM 切换后保持 false，避免旧 Go WS/PostgreSQL 消息链路双写。
LEGACY_CHAT_ENABLED=false
# 仅本地演示环境使用；生产必须保持 false。
SEED_DEMO=false

# Phase 5: Kafka 群发（留空则本地日志模拟）
KAFKA_BROKERS=
KAFKA_FORWARD_TOPIC=im-forward-tasks

# 阿里云短信服务（发短信验证码）：配置后真发，否则 dev 网关只记日志
# ⚠️ 密钥是敏感信息：这里用 CHANGE_ME 占位（GitHub 推送保护会拦截真实密钥），部署时在服务器 .env 填真实值
ALIYUN_ACCESS_KEY_ID=CHANGE_ME
ALIYUN_ACCESS_KEY_SECRET=CHANGE_ME
# 签名/模板在阿里云控制台"短信服务"申请，审核通过后填（下面是参考值）
SMS_SIGN_NAME=舞阳县旺鸿盛科技有限公司
SMS_TEMPLATE_CODE=SMS_337356265
SMS_REGION_ID=cn-hangzhou
