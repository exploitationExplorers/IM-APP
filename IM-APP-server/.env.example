HTTP_ADDR=:8080
DATABASE_URL=postgres://im:im123456@127.0.0.1:5433/im_app?sslmode=disable
JWT_SECRET=im-local-dev-secret-change-me
DEV_SMS_CODE=123456

# Phase 3: Redis + MinIO（docker-compose up 后启用）
REDIS_URL=redis://127.0.0.1:6379/0
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=im-uploads
MINIO_USE_SSL=false

# Phase 4: OpenIM（deploy/openim 启动后填写）
OPENIM_API_URL=
OPENIM_SECRET=
OPENIM_ADMIN_USER=imAdmin

# Phase 5: Kafka 群发（留空则本地日志模拟）
KAFKA_BROKERS=
KAFKA_FORWARD_TOPIC=im-forward-tasks

# 腾讯云图形验证码（天御 Captcha；未配置则开发环境跳过校验，配置后发短信前强制）
# CAPTCHA_APP_ID / CAPTCHA_APP_SECRET_KEY 在腾讯云控制台"验证码"应用里获取
# TENCENTCLOUD_SECRET_ID / TENCENTCLOUD_SECRET_KEY 是腾讯云 API 密钥
CAPTCHA_APP_ID=
CAPTCHA_APP_SECRET_KEY=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
