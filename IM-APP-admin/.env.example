# IM-APP 管理后台服务配置模板
# 复制为 .env 并按需修改（.env 含密钥，勿提交到 git）

# 服务监听地址
HTTP_ADDR=:8090

# PostgreSQL 连接串
DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/im_app?sslmode=disable

# 管理端 JWT 密钥（优先 ADMIN_JWT_SECRET；不设则兼容 JWT_SECRET）
ADMIN_JWT_SECRET=
# JWT_SECRET=im-local-dev-secret-change-me

# 首次启动初始化超级管理员（admin / 此密码）；已有管理员后不再生效
ADMIN_BOOTSTRAP_PASSWORD=
# 超管用户名（默认 admin）
# ADMIN_BOOTSTRAP_USERNAME=admin

# 登录安全：失败阈值与锁定分钟
# ADMIN_LOGIN_FAIL_THRESHOLD=5
# ADMIN_LOGIN_LOCK_MINUTES=15

# 访问令牌时长（如 2h / 30m）
# ADMIN_ACCESS_TTL=2h
# ADMIN_REFRESH_TTL=168h

# 允许跨域的前端来源（逗号分隔）
# ADMIN_CORS_ORIGINS=http://localhost:5180

# ===== 方案 A：写操作走 server 内部接口（群/转发/用户/撤回同步 OpenIM）=====
# server 服务地址（如 http://127.0.0.1:8080）
SERVER_BASE_URL=
# 与 server 的 IM_INTERNAL_API_KEY 保持一致
SERVER_INTERNAL_KEY=
GROUP_MEMBER_HARD_LIMIT=4000
